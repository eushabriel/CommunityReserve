{
  "name": "community-reserve",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "concurrently -n FRONTEND,PHP -c blue,green \"npm run dev:frontend\" \"npm run dev:php\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:php": "php -S localhost:8000 backend/router.php",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
